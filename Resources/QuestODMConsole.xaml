<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        x:Name="QuestOdmWindow"
        Title="Quest ODM Operations Console 1.1.0 RC 1"
        Width="1440" Height="920" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- Theme brushes remain unfrozen so the controller can update their Color values safely at runtime. -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3D5B96"  po:Freeze="False" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#2E4778"  po:Freeze="False" />
        <SolidColorBrush x:Key="MetricValueBrush" Color="#2E4778"  po:Freeze="False" />
        <SolidColorBrush x:Key="AccentBrush" Color="#62C0DA"  po:Freeze="False" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#E8F7FB"  po:Freeze="False" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#17384A"  po:Freeze="False" />
        <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF"  po:Freeze="False" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"  po:Freeze="False" />
        <SolidColorBrush x:Key="InputSurfaceBrush" Color="#FFFFFF"  po:Freeze="False" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F6FBFE"  po:Freeze="False" />
        <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#F7F9FC"  po:Freeze="False" />
        <SolidColorBrush x:Key="StatusSurfaceBrush" Color="#F1F3F7"  po:Freeze="False" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D0D8E5"  po:Freeze="False" />
        <SolidColorBrush x:Key="TextBrush" Color="#273142"  po:Freeze="False" />
        <SolidColorBrush x:Key="HeadingBrush" Color="#253148"  po:Freeze="False" />
        <SolidColorBrush x:Key="MutedBrush" Color="#657086"  po:Freeze="False" />
        <SolidColorBrush x:Key="GridLineBrush" Color="#E8ECF2"  po:Freeze="False" />
        <SolidColorBrush x:Key="GridAlternateBrush" Color="#F8FAFD"  po:Freeze="False" />
        <SolidColorBrush x:Key="GridHeaderBrush" Color="#EDF2F8"  po:Freeze="False" />
        <SolidColorBrush x:Key="GridHeaderTextBrush" Color="#39465A"  po:Freeze="False" />
        <SolidColorBrush x:Key="SelectionBrush" Color="#DCE9F8"  po:Freeze="False" />
        <SolidColorBrush x:Key="SelectionTextBrush" Color="#17233A"  po:Freeze="False" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B54343"  po:Freeze="False" />
        <SolidColorBrush x:Key="DangerLightBrush" Color="#FBECEC"  po:Freeze="False" />
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#D78484"  po:Freeze="False" />
        <SolidColorBrush x:Key="DangerTextBrush" Color="#9B2E2E"  po:Freeze="False" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D5B"  po:Freeze="False" />
        <SolidColorBrush x:Key="SuccessLightBrush" Color="#EAF6F0"  po:Freeze="False" />
        <SolidColorBrush x:Key="WarningBrush" Color="#A86B18"  po:Freeze="False" />
        <SolidColorBrush x:Key="WarningLightBrush" Color="#FFF5DF"  po:Freeze="False" />
        <SolidColorBrush x:Key="WarningBorderBrush" Color="#E3B76A"  po:Freeze="False" />
        <SolidColorBrush x:Key="WarningTextBrush" Color="#8A5510"  po:Freeze="False" />
        <SolidColorBrush x:Key="NeutralDotBrush" Color="#7A8496"  po:Freeze="False" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#28000000" BlurRadius="7" ShadowDepth="1" Opacity="0.18" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverviewMetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MetricValueBrush}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>
        <Style x:Key="OverviewBodyTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <ControlTemplate x:Key="ThemedChoiceTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Foreground="{TemplateBinding Foreground}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3"><Grid><Path Data="M 0 0 L 4 4 L 8 0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Grid></Border></ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False" Margin="8,4,26,4" VerticalAlignment="Center"/>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers><Trigger Property="IsEditable" Value="False"><Setter Property="Template" Value="{StaticResource ThemedChoiceTemplate}"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="7,5" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,12,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Padding" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MetricValueBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MetricValueBrush}" />
        </Style>
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
        </Style>
        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" CornerRadius="16" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentLightBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PrimaryDarkBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAlternateBrush}" />
            <Setter Property="AutoGenerateColumns" Value="True" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource GridHeaderTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="126" Height="54" VerticalAlignment="Center" ToolTip="Quest Software">
                    <Image x:Name="QuestLogoImage"
                           Width="122"
                           Height="31"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="14,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="Quest ODM Operations Console" TextTrimming="CharacterEllipsis" ToolTip="Quest ODM Operations Console" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
                    <TextBlock Text="Organization, workload, object, collection, and task administration" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="SafeModeStatusBorder" Background="{DynamicResource WarningLightBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="11,6" Margin="0,0,10,0" ToolTip="Safe Mode blocks Quest and local write operations. It resets whenever the active Quest context changes.">
                        <TextBlock x:Name="SafeModeStatusText" Text="SAFE MODE — Read-only" Foreground="{DynamicResource WarningTextBrush}" FontWeight="Bold" />
                    </Border>
                    <Button x:Name="ToggleSafeModeButton" Content="Enable changes" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" ToolTip="Explicitly enable or disable write operations for the active organization, project, and workload." />
                    <Border x:Name="ConnectionStatusBorder" Background="{DynamicResource StatusSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="11,6" Margin="8,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionStatusDot" Width="8" Height="8" Fill="{DynamicResource NeutralDotBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="ConnectionStatusText" Text="Disconnected" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="ConnectButton" Content="Connect" Style="{StaticResource PrimaryButtonStyle}" />
                    <Button x:Name="DisconnectButton" Content="Disconnect" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" />
                    <Button x:Name="RefreshWorkspaceButton" Content="Refresh" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                    <Button x:Name="AboutButton" Content="About" Style="{StaticResource GhostButtonStyle}" ToolTip="Show version, compatibility, and support information." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Context selectors -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="18,14,18,4" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Label Content="Region" />
                    <ComboBox x:Name="RegionCombo" SelectedIndex="0">
                        <ComboBoxItem Content="US" />
                        <ComboBoxItem Content="EU" />
                        <ComboBoxItem Content="AU" />
                        <ComboBoxItem Content="CA" />
                        <ComboBoxItem Content="UK" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <Label Content="Organization" />
                    <ComboBox x:Name="OrganizationCombo" DisplayMemberPath="DisplayText" SelectedValuePath="Id" IsEnabled="False" ToolTip="Organizations available to the authenticated Quest account." />
                    <TextBox x:Name="OrganizationIdBox" Margin="0,5,0,0" ToolTip="Select an organization above or enter its organization GUID manually." />
                </StackPanel>
                <Button x:Name="SelectOrganizationButton" Grid.Column="2" Content="Select" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,12,0" IsEnabled="False" />
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <Label Content="Project" />
                    <ComboBox x:Name="ProjectCombo" DisplayMemberPath="DisplayText" SelectedValuePath="Id" IsEnabled="False" ToolTip="Projects available in the selected organization." />
                </StackPanel>
                <Button x:Name="SelectProjectButton" Grid.Column="4" Content="Select" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,12,0" IsEnabled="False" />
                <StackPanel Grid.Column="5" Margin="0,0,8,0">
                    <Label Content="Workload / context" />
                    <ComboBox x:Name="WorkloadCombo" DisplayMemberPath="DisplayText" SelectedValuePath="Id" IsEnabled="False" ToolTip="Child workloads plus the root project context." />
                </StackPanel>
                <Button x:Name="SelectWorkloadButton" Grid.Column="6" Content="Open" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" IsEnabled="False" />
            </Grid>
        </Border>

        <!-- Main tabs -->
        <TabControl x:Name="MainTabControl" Grid.Row="2" Margin="18,8,18,8">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" Foreground="{DynamicResource TextBrush}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="ODM objects" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="OverviewObjectCount" Text="—" Style="{StaticResource OverviewMetricValueStyle}" /></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="Tasks" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="OverviewTaskCount" Text="—" Style="{StaticResource OverviewMetricValueStyle}" /></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="Collections" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="OverviewCollectionCount" Text="—" Style="{StaticResource OverviewMetricValueStyle}" /></StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="Running / queued" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="OverviewRunningCount" Text="—" Style="{StaticResource OverviewMetricValueStyle}" /></StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                                <StackPanel><TextBlock Text="Failed / error" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="OverviewFailedCount" Text="—" Style="{StaticResource OverviewMetricValueStyle}" /></StackPanel>
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock Text="Active context" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                        <Button x:Name="OverviewRefreshButton" Content="Refresh workspace" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" HorizontalAlignment="Right" IsEnabled="False" />
                                    </DockPanel>
                                    <TextBlock x:Name="OverviewContextText" Text="Connect and select a workload to begin." TextWrapping="Wrap" FontSize="14" LineHeight="23" Style="{StaticResource OverviewBodyTextStyle}" />
                                    <Separator Margin="0,15" />
                                    <TextBlock Text="Runtime" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,7" />
                                    <TextBlock x:Name="OverviewModuleText" Text="OdmApi not loaded." TextWrapping="Wrap" Style="{StaticResource OverviewBodyTextStyle}" />
                                    <TextBlock x:Name="OverviewRefreshedText" Text="No workspace refresh has run." Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Operating safeguards" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <TextBlock Text="• Bulk changes are dry-run by default." TextWrapping="Wrap" Margin="0,3" />
                                    <TextBlock Text="• Task creation does not start tasks." TextWrapping="Wrap" Margin="0,3" />
                                    <TextBlock Text="• Selected-task deletion requires confirmation." TextWrapping="Wrap" Margin="0,3" />
                                    <TextBlock Text="• Delete-all requires an exact typed phrase." TextWrapping="Wrap" Margin="0,3" />
                                    <TextBlock Text="• Every CSV operation writes an audit report." TextWrapping="Wrap" Margin="0,3" />
                                    <TextBlock Text="• No Quest credentials or tokens are written to settings." TextWrapping="Wrap" Margin="0,3" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Users">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /><RowDefinition Height="2*" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="95" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><Label Content="Search display name, source/target UPN, email, or object ID" /><TextBox x:Name="UserSearchBox" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0"><Label Content="Max results" /><TextBox x:Name="UserMaxResultsBox" Text="1000" /></StackPanel>
                            <Button x:Name="UserSearchButton" Grid.Column="2" Content="Search" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" IsEnabled="False" />
                            <Button x:Name="UserRefreshButton" Grid.Column="3" Content="Reload objects" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" IsEnabled="False" />
                        </Grid>
                    </Border>
                    <DataGrid x:Name="UserGrid" Grid.Row="1" Margin="0,0,0,12" />
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12">
                        <DockPanel>
                            <TextBlock x:Name="SelectedUserText" Text="No user selected." FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button x:Name="LoadUserAssociationsButton" Content="Find collections and tasks" Style="{StaticResource AccentButtonStyle}" DockPanel.Dock="Right" IsEnabled="False" />
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                        <TabControl Grid.Column="0" Margin="0,0,10,0">
                            <TabItem Header="Task memberships"><DataGrid x:Name="UserTaskAssociationsGrid" Margin="0,10,0,0" /></TabItem>
                            <TabItem Header="Collection memberships"><DataGrid x:Name="UserCollectionAssociationsGrid" Margin="0,10,0,0" /></TabItem>
                        </TabControl>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Direct membership actions" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <Label Content="Target task" />
                                <ComboBox x:Name="UserTargetTaskCombo" DisplayMemberPath="Name" SelectedValuePath="Id" IsEnabled="False" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
                                    <Button x:Name="AddUserToTaskButton" Content="Add to task" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" />
                                    <Button x:Name="RemoveUserFromTaskButton" Content="Remove from task" Style="{StaticResource DangerButtonStyle}" IsEnabled="False" />
                                </StackPanel>
                                <Label Content="Target collection" />
                                <ComboBox x:Name="UserTargetCollectionCombo" DisplayMemberPath="Name" SelectedValuePath="Id" IsEnabled="False" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="AddUserToCollectionButton" Content="Add to collection" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" />
                                    <Button x:Name="RemoveUserFromCollectionButton" Content="Remove from collection" Style="{StaticResource DangerButtonStyle}" IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Tasks">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /><RowDefinition Height="2*" MinHeight="200" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><Label Content="Task search" /><TextBox x:Name="TaskSearchBox" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0"><Label Content="Status" /><ComboBox x:Name="TaskStatusCombo"><ComboBoxItem Content="All" /></ComboBox></StackPanel>
                            <Button x:Name="TaskSearchButton" Grid.Column="2" Content="Filter" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" IsEnabled="False" />
                            <Button x:Name="TaskRefreshButton" Grid.Column="3" Content="Reload" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" IsEnabled="False" />
                            <Button x:Name="ExportTasksButton" Grid.Column="4" Content="Export" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" IsEnabled="False" />
                        </Grid>
                    </Border>
                    <DataGrid x:Name="TaskGrid" Grid.Row="1" Margin="0,0,0,12" />
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12">
                        <DockPanel>
                            <TextBlock x:Name="SelectedTaskText" Text="No task selected." FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button x:Name="LoadTaskMembersButton" Content="Load members" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                                <Button x:Name="StartSelectedTasksButton" Content="Start selected" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" />
                                <Button x:Name="StopSelectedTasksButton" Content="Stop selected" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" />
                                <Button x:Name="DeleteSelectedTasksButton" Content="Delete selected" Style="{StaticResource DangerButtonStyle}" IsEnabled="False" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TabControl Grid.Row="3" x:Name="TaskDetailTabControl">
                        <TabItem Header="Members">
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                <DataGrid x:Name="TaskMembersGrid" Grid.Column="0" Margin="0,0,10,0" />
                                <Border x:Name="TaskCsvActionCard" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0" Padding="12">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel x:Name="TaskCsvActionFooter" DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                            <CheckBox x:Name="TaskCsvExecuteCheckBox"
                                                      Content="Execute API changes (unchecked = preview)"
                                                      Margin="0,0,0,7"
                                                      ToolTip="Unchecked generates a report-only preview. To submit changes, first disable Safe Mode for the active context, then check this option." />
                                            <WrapPanel>
                                                <Button x:Name="AddCsvUsersToTaskButton"
                                                        Content="Add CSV users"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        IsEnabled="False"
                                                        ToolTip="Add the resolved CSV users to the selected task. Unchecked execution mode produces a preview report only." />
                                                <Button x:Name="RemoveCsvUsersFromTaskButton"
                                                        Content="Remove CSV users"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        IsEnabled="False"
                                                        ToolTip="Remove the resolved CSV users from the selected task. Unchecked execution mode produces a preview report only." />
                                            </WrapPanel>
                                        </StackPanel>
                                        <ScrollViewer x:Name="TaskCsvInputScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="CSV membership action" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                <Label Content="CSV containing SourceUPN or SourceEmail" />
                                                <DockPanel><Button x:Name="BrowseTaskCsvButton" Content="Browse" Style="{StaticResource GhostButtonStyle}" DockPanel.Dock="Right" /><TextBox x:Name="TaskCsvPathBox" Margin="0,0,6,0" /></DockPanel>
                                                <Label Content="Report directory" Margin="0,9,0,0" />
                                                <DockPanel><Button x:Name="BrowseTaskOutputDirectoryButton" Content="Browse" Style="{StaticResource GhostButtonStyle}" DockPanel.Dock="Right" /><TextBox x:Name="TaskOutputDirectoryBox" Text="" Margin="0,0,6,0" /></DockPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Task details and monitoring">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="10">
                                    <DockPanel>
                                        <TextBlock x:Name="TaskDetailsStatusText" Text="Select one task and refresh details." FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <CheckBox x:Name="TaskDetailsAutoRefreshCheckBox" Content="Auto-refresh" ToolTip="Refresh selected task details periodically. Pauses while another operation is running." />
                                            <ComboBox x:Name="TaskDetailsRefreshSecondsCombo" Width="76" SelectedIndex="1" ToolTip="Auto-refresh interval in seconds"><ComboBoxItem Content="15" /><ComboBoxItem Content="30" /><ComboBoxItem Content="60" /><ComboBoxItem Content="120" /></ComboBox>
                                            <Button x:Name="RefreshTaskDetailsButton" Content="Refresh details" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                                            <Button x:Name="ExportTaskDetailsButton" Content="Export details" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" />
                                            <Button x:Name="CreateTaskErrorExportButton" Content="Create error-log export" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" ToolTip="Creates a Quest reporting task scoped to the selected task when the installed OdmApi supports it." />
                                            <Button x:Name="CopyTaskIdButton" Content="Copy ID" Style="{StaticResource GhostButtonStyle}" IsEnabled="False" />
                                            <Button x:Name="CopyTaskDiagnosticButton" Content="Copy summary" Style="{StaticResource GhostButtonStyle}" IsEnabled="False" />
                                        </WrapPanel>
                                    </DockPanel>
                                </Border>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TaskDetailsTextBox" Grid.Column="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,0,10,0" />
                                    <DataGrid x:Name="TaskEventsGrid" Grid.Column="1" />
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="Collections">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /><RowDefinition Height="2*" MinHeight="200" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="230" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><Label Content="Collection search" /><TextBox x:Name="CollectionSearchBox" /></StackPanel>
                            <Button x:Name="CollectionSearchButton" Grid.Column="1" Content="Filter" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" IsEnabled="False" />
                            <Button x:Name="CollectionRefreshButton" Grid.Column="2" Content="Reload" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" IsEnabled="False" />
                            <Button x:Name="ExportCollectionsButton" Grid.Column="3" Content="Export" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" IsEnabled="False" />
                            <StackPanel Grid.Column="4" Margin="12,0,4,0"><Label Content="New collection name" /><TextBox x:Name="NewCollectionNameBox" /></StackPanel>
                            <Button x:Name="CreateCollectionButton" Grid.Column="5" Content="Create" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" IsEnabled="False" />
                        </Grid>
                    </Border>
                    <DataGrid x:Name="CollectionGrid" Grid.Row="1" Margin="0,0,0,12" />
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12">
                        <DockPanel>
                            <TextBlock x:Name="SelectedCollectionText" Text="No collection selected." FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button x:Name="LoadCollectionMembersButton" Content="Load members" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                                <Button x:Name="DeleteSelectedCollectionsButton" Content="Delete selected" Style="{StaticResource DangerButtonStyle}" IsEnabled="False" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                        <DataGrid x:Name="CollectionMembersGrid" Grid.Column="0" Margin="0,0,10,0" />
                        <Border x:Name="CollectionCsvActionCard" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0" Padding="12">
                            <DockPanel LastChildFill="True">
                                <StackPanel x:Name="CollectionCsvActionFooter" DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <CheckBox x:Name="CollectionCsvExecuteCheckBox"
                                              Content="Execute API changes (unchecked = preview)"
                                              Margin="0,0,0,7"
                                              ToolTip="Unchecked generates a report-only preview. To submit changes, first disable Safe Mode for the active context, then check this option." />
                                    <WrapPanel>
                                        <Button x:Name="AddCsvUsersToCollectionButton"
                                                Content="Add CSV users"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                IsEnabled="False"
                                                ToolTip="Add the resolved CSV users to the selected collection. Unchecked execution mode produces a preview report only." />
                                        <Button x:Name="RemoveCsvUsersFromCollectionButton"
                                                Content="Remove CSV users"
                                                Style="{StaticResource DangerButtonStyle}"
                                                IsEnabled="False"
                                                ToolTip="Remove the resolved CSV users from the selected collection. Unchecked execution mode produces a preview report only." />
                                    </WrapPanel>
                                </StackPanel>
                                <ScrollViewer x:Name="CollectionCsvInputScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="CSV membership action" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <Label Content="CSV containing SourceUPN or SourceEmail" />
                                        <DockPanel><Button x:Name="BrowseCollectionCsvButton" Content="Browse" Style="{StaticResource GhostButtonStyle}" DockPanel.Dock="Right" /><TextBox x:Name="CollectionCsvPathBox" Margin="0,0,6,0" /></DockPanel>
                                        <Label Content="Report directory" Margin="0,9,0,0" />
                                        <DockPanel><Button x:Name="BrowseCollectionOutputDirectoryButton" Content="Browse" Style="{StaticResource GhostButtonStyle}" DockPanel.Dock="Right" /><TextBox x:Name="CollectionOutputDirectoryBox" Text="" Margin="0,0,6,0" /></DockPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Task Factory">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"><Label Content="Creation mode" /><ComboBox x:Name="FactoryModeCombo"><ComboBoxItem Content="Direct" IsSelected="True" /><ComboBoxItem Content="Template" /></ComboBox></StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8"><Label Content="Existing task behavior" /><ComboBox x:Name="ExistingTaskBehaviorCombo"><ComboBoxItem Content="Skip" IsSelected="True" /><ComboBoxItem Content="Fail" /><ComboBoxItem Content="Allow" /></ComboBox></StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8"><Label Content="CSV: CollectionName plus SourceUPN/SourceEmail" /><DockPanel><Button x:Name="BrowseFactoryCsvButton" Content="Browse" Style="{StaticResource GhostButtonStyle}" DockPanel.Dock="Right" /><TextBox x:Name="FactoryCsvPathBox" Margin="0,0,6,0" /></DockPanel></StackPanel>
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,8"><Label Content="Report directory" /><DockPanel><Button x:Name="BrowseFactoryOutputDirectoryButton" Content="Browse" Style="{StaticResource GhostButtonStyle}" DockPanel.Dock="Right" /><TextBox x:Name="FactoryOutputDirectoryBox" Text="" Margin="0,0,6,0" /></DockPanel></StackPanel>
                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,8"><Label Content="Completion notification recipients (semicolon-separated; optional)" /><TextBox x:Name="FactoryNotifyRecipientsBox" /></StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,8"><Label Content="Mail migration start date" /><DatePicker x:Name="FactoryMailFromPicker" SelectedDate="2025-11-01" /></StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="1" Margin="8,0,0,8"><Label Content="OneDrive item filter" /><ComboBox x:Name="FactoryOneDriveFilterCombo"><ComboBoxItem Content="AfterLastSuccessfulRun" IsSelected="True" /><ComboBoxItem Content="AllItems" /></ComboBox></StackPanel>
                                <StackPanel Grid.Row="5" Grid.ColumnSpan="2">
                                    <WrapPanel>
                                        <CheckBox x:Name="FactoryMailCheckBox" Content="Mail" IsChecked="True" />
                                        <CheckBox x:Name="FactoryOneDriveCheckBox" Content="OneDrive" IsChecked="True" />
                                        <CheckBox x:Name="FactoryMeetingLinkCheckBox" Content="Meeting links" IsChecked="True" />
                                        <CheckBox x:Name="FactoryMailboxSwitchCheckBox" Content="Mailbox switch" IsChecked="True" />
                                        <CheckBox x:Name="FactoryLinkTasksCheckBox" Content="Link tasks to matching collections" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Verification and naming" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,8"><Label Content="Max users / task" /><TextBox x:Name="FactoryMaxUsersBox" Text="1000" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,6,8"><Label Content="Verification retries" /><TextBox x:Name="FactoryVerificationRetriesBox" Text="6" /></StackPanel>
                                    <StackPanel Grid.Column="2" Margin="6,0,0,8"><Label Content="Delay seconds" /><TextBox x:Name="FactoryVerificationDelayBox" Text="5" /></StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,8">
                                        <Label Content="Mail naming text and placement" />
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                                            <TextBox x:Name="FactoryMailSuffixBox" Text="Email Sync" />
                                            <ComboBox x:Name="FactoryMailPlacementCombo" Grid.Column="1" Margin="6,0,0,0"><ComboBoxItem Content="Suffix" IsSelected="True" /><ComboBoxItem Content="Prefix" /></ComboBox>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,8">
                                        <Label Content="OneDrive naming text and placement" />
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                                            <TextBox x:Name="FactoryOneDriveSuffixBox" Text="OneDrive Sync" />
                                            <ComboBox x:Name="FactoryOneDrivePlacementCombo" Grid.Column="1" Margin="6,0,0,0"><ComboBoxItem Content="Suffix" IsSelected="True" /><ComboBoxItem Content="Prefix" /></ComboBox>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,6,8">
                                        <Label Content="Meeting-link naming text and placement" />
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                                            <TextBox x:Name="FactoryMeetingLinkSuffixBox" Text="Meeting Link Migration" />
                                            <ComboBox x:Name="FactoryMeetingLinkPlacementCombo" Grid.Column="1" Margin="6,0,0,0"><ComboBoxItem Content="Suffix" IsSelected="True" /><ComboBoxItem Content="Prefix" /></ComboBox>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="6,0,0,8">
                                        <Label Content="Mailbox-switch naming text and placement" />
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                                            <TextBox x:Name="FactoryMailboxSwitchSuffixBox" Text="Mailbox Switch" />
                                            <ComboBox x:Name="FactoryMailboxSwitchPlacementCombo" Grid.Column="1" Margin="6,0,0,0"><ComboBoxItem Content="Suffix" IsSelected="True" /><ComboBoxItem Content="Prefix" /></ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="FactoryTemplateOptionsPanel" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" IsEnabled="False">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,8"><Label Content="Mail template" /><ComboBox x:Name="FactoryMailTemplateCombo" DisplayMemberPath="DisplayText" SelectedValuePath="Id" IsEditable="True" /></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,8"><Label Content="OneDrive template" /><ComboBox x:Name="FactoryOneDriveTemplateCombo" DisplayMemberPath="DisplayText" SelectedValuePath="Id" IsEditable="True" /></StackPanel>
                                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,6,0"><Label Content="Meeting-link template" /><ComboBox x:Name="FactoryMeetingLinkTemplateCombo" DisplayMemberPath="DisplayText" SelectedValuePath="Id" IsEditable="True" /></StackPanel>
                                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="6,0,0,0"><Label Content="Mailbox-switch template" /><ComboBox x:Name="FactoryMailboxSwitchTemplateCombo" DisplayMemberPath="DisplayText" SelectedValuePath="Id" IsEditable="True" /></StackPanel>
                                    </Grid>
                                </Border>
                                <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
                                    <Button x:Name="PreviewTaskFactoryButton" Content="Preview and report" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" />
                                    <Button x:Name="RunTaskFactoryButton" Content="Create tasks" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock x:Name="FactoryStatusText" Text="Preview is report-only. Created tasks are not started." FontWeight="SemiBold" Margin="0,0,0,8" />
                            <DataGrid x:Name="FactorySummaryGrid" Grid.Row="1" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Bulk Operations">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <Label Content="Operation" />
                                <ComboBox x:Name="BulkOperationCombo" DisplayMemberPath="Name" SelectedValuePath="Key" />
                                <TextBlock x:Name="BulkDescriptionText" Text="Select an operation." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                                <Border Margin="0,14,0,0" Padding="10" Background="{DynamicResource AccentLightBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Right" Background="{DynamicResource WarningLightBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="8,0,0,0">
                                                <TextBlock Text="PREVIEW" Foreground="{DynamicResource WarningTextBrush}" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="Mapping collision utility" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="Compare source and target AD or Entra user identity inventories before mappings are created. Runs as a separate read-only application and does not require a Quest connection." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,8" />
                                        <WrapPanel>
                                            <Button x:Name="LaunchMappingCollisionUtilityButton" Content="Launch utility" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,4" />
                                            <Button x:Name="OpenMappingCollisionUtilityFolderButton" Content="Open utility folder" Style="{StaticResource GhostButtonStyle}" Margin="0,0,0,4" />
                                        </WrapPanel>
                                        <TextBlock x:Name="MappingCollisionUtilityStatusText" Text="Checking packaged utility…" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <Label Content="CSV path (when required)" />
                                <DockPanel>
                                    <Button x:Name="BrowseBulkCsvButton" Content="Browse" Style="{StaticResource GhostButtonStyle}" DockPanel.Dock="Right" />
                                    <Button x:Name="OpenBulkTemplateButton" Content="Open template" Style="{StaticResource GhostButtonStyle}" DockPanel.Dock="Right" Margin="0,0,6,0" IsEnabled="False" />
                                    <TextBox x:Name="BulkCsvPathBox" Margin="0,0,6,0" />
                                </DockPanel>
                                <TextBlock x:Name="BulkTemplateHintText" Text="" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <Label Content="Quest task name (account discovery/mapping only)" Margin="0,8,0,0" />
                                <TextBox x:Name="BulkTaskNameBox" IsEnabled="False" />
                                <Label Content="Report directory" Margin="0,8,0,0" />
                                <DockPanel><Button x:Name="BrowseBulkOutputDirectoryButton" Content="Browse" Style="{StaticResource GhostButtonStyle}" DockPanel.Dock="Right" /><TextBox x:Name="BulkOutputDirectoryBox" Text="" Margin="0,0,6,0" /></DockPanel>
                                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0"><Label Content="Name regex patterns (comma-separated)" /><TextBox x:Name="BulkNamePatternsBox" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0"><Label Content="Object match email column" /><TextBox x:Name="BulkEmailColumnBox" Text="SourceEmail" /></StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Execution controls" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,7" />
                                <CheckBox x:Name="BulkExecuteCheckBox" Content="Execute changes (default is dry run)" />
                                <CheckBox x:Name="BulkStartCreatedTaskCheckBox" Content="Start newly created account task" IsEnabled="False" />
                                <CheckBox x:Name="BulkStopRunningCheckBox" Content="Stop running tasks before deletion" IsChecked="True" />
                                <CheckBox x:Name="BulkIncludeAllProjectsCheckBox" Content="Export tasks from all projects" />
                                <Label Content="Destructive confirmation text" Margin="0,6,0,0" />
                                <TextBox x:Name="BulkConfirmationBox" />
                                <Button x:Name="RunBulkOperationButton" Content="Run operation" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Margin="0,11,0,0" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock x:Name="BulkStatusText" Text="Results and report paths appear here." FontWeight="SemiBold" Margin="0,0,0,8" />
                            <DataGrid x:Name="BulkResultsGrid" Grid.Row="1" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Teams / SharePoint / Power BI">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" MaxHeight="340" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Workload objects" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Open the workload above, then load its options. Existing task monitoring and start/stop actions are on Tasks." TextWrapping="Wrap" Margin="0,6,0,6" />
                                    <Button x:Name="ContentLoadOptionsButton" Content="Load workload options" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" />
                                    <Label Content="Object kind" /><ComboBox x:Name="ContentObjectKindCombo" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="ContentInventoryButton" Content="Load inventory" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" />
                                        <Button x:Name="ContentExportButton" Content="Export grid to CSV" Style="{StaticResource GhostButtonStyle}" />
                                    </WrapPanel>
                                    <TextBlock Text="Inventory exports include ObjectId, WorkloadId and ObjectKind. Fill CollectionName and TaskName to use the export as input." TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <Label Content="CSV action" /><ComboBox x:Name="ContentActionCombo"><ComboBoxItem Content="Create / populate collections" Tag="Collections" IsSelected="True" /><ComboBoxItem Content="Create collections and tasks" Tag="Tasks" /></ComboBox>
                                    <Label Content="CSV path" />
                                    <DockPanel><Button x:Name="ContentBrowseButton" Content="Browse" DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}" /><TextBox x:Name="ContentCsvPathBox" /></DockPanel>
                                    <Label Content="Task kind" /><ComboBox x:Name="ContentTaskKindCombo" DisplayMemberPath="Name" SelectedValuePath="Key" />
                                    <Label Content="Migration template ID (template tasks only)" /><TextBox x:Name="ContentTemplateBox" />
                                    <Label Content="Target administrator UPN (Power BI tasks)" /><TextBox x:Name="ContentAdminBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Creation settings" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ContentSettingsText" Text="Load workload options to begin." TextWrapping="Wrap" Margin="0,6,0,8" />
                                    <CheckBox x:Name="ContentLinkCheckBox" Content="Link created tasks to collections" IsChecked="True" />
                                    <CheckBox x:Name="ContentExecuteCheckBox" Content="Execute changes" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="ContentPreviewButton" Content="Preview CSV" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" />
                                        <Button x:Name="ContentExecuteButton" Content="Execute CSV" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" />
                                    </WrapPanel>
                                    <TextBlock Text="Tasks are created for later review and are not started. Reports use the Bulk Operations report directory. Existing task names are skipped." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock x:Name="ContentStatusText" Text="Select a Teams, SharePoint, or Power BI workload above." TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DataGrid x:Name="ContentResultsGrid" Grid.Row="1" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostics">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="Runtime, compatibility, and module" FontSize="18" FontWeight="SemiBold" /><Button x:Name="RefreshEnvironmentButton" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" /></DockPanel>
                                    <TextBox x:Name="EnvironmentTextBox" Height="145" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" FontFamily="Consolas" />
                                    <Separator Margin="0,12,0,10" />
                                    <TextBlock Text="OdmApi version policy" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="OdmApiModuleStatusText" Text="Checking installed module status…" TextWrapping="Wrap" Margin="0,6,0,4" />
                                    <TextBlock x:Name="CompatibilityStatusText" Text="Compatibility has not been assessed." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <Button x:Name="CheckOdmApiVersionButton" Content="Check latest" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button x:Name="InstallOdmApiButton" Content="Install validated" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" ToolTip="Installs the OdmApi version validated for this console release." />
                                        <Button x:Name="UpdateOdmApiButton" Content="Repair validated" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" ToolTip="Installs or reinstalls the validated OdmApi version." />
                                        <Button x:Name="InstallLatestOdmApiButton" Content="Install latest (advanced)" Style="{StaticResource GhostButtonStyle}" IsEnabled="False" ToolTip="Installs the latest PowerShell Gallery release, which may not yet be validated for this console." />
                                    </WrapPanel>
                                    <TextBlock x:Name="OdmApiModuleActionText" Text="Normal installation targets the validated version. Installing the latest unvalidated version is an advanced action." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <Label Content="Manual validated install command" Margin="0,10,0,0" />
                                    <DockPanel><Button x:Name="CopyInstallCommandButton" Content="Copy" Style="{StaticResource GhostButtonStyle}" DockPanel.Dock="Right" /><TextBox x:Name="InstallModuleCommandBox" Text="Install-Module OdmApi -RequiredVersion 2.1.396 -Scope CurrentUser -Force -AllowClobber" IsReadOnly="True" Margin="0,0,6,0" /></DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="V1 readiness" FontSize="18" FontWeight="SemiBold" /><Button x:Name="RunReadinessButton" Content="Run readiness check" Style="{StaticResource PrimaryButtonStyle}" DockPanel.Dock="Right" /></DockPanel>
                                    <CheckBox x:Name="ReadinessOnlineCheckBox" Content="Include PowerShell Gallery version lookup" ToolTip="Adds an online latest-version check. Tenant and host checks still run when this is unchecked." />
                                    <TextBlock x:Name="ReadinessSummaryText" Text="No readiness check has run." TextWrapping="Wrap" Margin="0,6,0,8" />
                                    <WrapPanel>
                                        <Button x:Name="OpenReadinessReportButton" Content="Open HTML report" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                                        <Button x:Name="CopyReadinessSummaryButton" Content="Copy summary" Style="{StaticResource GhostButtonStyle}" IsEnabled="False" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Configuration profiles" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Profiles contain non-sensitive preferences only and never enable changes or automatically open a Quest context." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,8" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0"><Label Content="Saved profile" /><ComboBox x:Name="ProfileCombo" DisplayMemberPath="Name" SelectedValuePath="Name" /></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0"><Label Content="Profile name" /><TextBox x:Name="ProfileNameBox" /></StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,9,0,0">
                                        <Button x:Name="SaveProfileButton" Content="Save profile" Style="{StaticResource PrimaryButtonStyle}" />
                                        <Button x:Name="LoadProfileButton" Content="Load profile" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button x:Name="DeleteProfileButton" Content="Delete profile" Style="{StaticResource DangerButtonStyle}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Support and local preflight" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MmpcStateText" Text="MmpcEnrollmentFlag not checked." FontWeight="SemiBold" Margin="0,7,0,4" />
                                    <TextBlock Text="The registry action checks only HKLM\SOFTWARE\Microsoft\Enrollments\MmpcEnrollmentFlag in the 64-bit registry view." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button x:Name="TestMmpcButton" Content="Test value" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button x:Name="RemoveMmpcButton" Content="Remove value" Style="{StaticResource DangerButtonStyle}" />
                                        <Button x:Name="CreateSupportBundleButton" Content="Create support bundle" Style="{StaticResource AccentButtonStyle}" ToolTip="Creates a sanitized ZIP containing logs, version data, readiness results, and redacted settings." />
                                        <Button x:Name="OpenLogsButton" Content="Open logs" Style="{StaticResource GhostButtonStyle}" />
                                    </WrapPanel>
                                    <Separator Margin="0,12,0,10" />
                                    <TextBlock Text="Log maintenance" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Automatic retention runs at startup. The current session log is never deleted by these controls." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="Keep logs for" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <ComboBox x:Name="LogRetentionDaysCombo" Width="84" SelectedIndex="2" Margin="0,0,6,0" ToolTip="Number of days to retain session logs and structured operation history.">
                                            <ComboBoxItem Content="7" />
                                            <ComboBoxItem Content="14" />
                                            <ComboBoxItem Content="30" />
                                            <ComboBoxItem Content="60" />
                                            <ComboBoxItem Content="90" />
                                            <ComboBoxItem Content="180" />
                                        </ComboBox>
                                        <TextBlock Text="days" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button x:Name="CleanOldLogsButton" Content="Apply retention now" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Deletes expired session logs, prunes expired operation-history records, and trims the bootstrap log when needed." />
                                        <Button x:Name="ClearStoredLogsButton" Content="Clear stored logs" Style="{StaticResource DangerButtonStyle}" ToolTip="Deletes prior session logs and clears stored bootstrap and operation-history data. The active session log is preserved." />
                                    </WrapPanel>
                                    <TextBlock x:Name="LogRetentionStatusText" Text="Log maintenance has not run." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="About" FontSize="18" FontWeight="SemiBold" />
                                    <TextBox x:Name="AboutTextBox" Height="128" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" FontFamily="Consolas" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <TabControl Grid.Column="1" x:Name="DiagnosticsDetailTabControl">
                        <TabItem Header="Session log">
                            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBox x:Name="DiagnosticsLogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                                    <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button x:Name="OpenReportsButton" Content="Open reports" Style="{StaticResource AccentButtonStyle}" />
                                        <Button x:Name="SaveLogButton" Content="Save log" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button x:Name="ClearLogButton" Content="Clear view" Style="{StaticResource GhostButtonStyle}" ToolTip="Clears only the visible session-log pane; it does not delete log files." />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem Header="Readiness">
                            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0"><DataGrid x:Name="ReadinessGrid" /></Border>
                        </TabItem>
                        <TabItem Header="Operation history">
                            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,8"><TextBlock Text="Recent structured operations" FontWeight="SemiBold" /><WrapPanel DockPanel.Dock="Right"><Button x:Name="RefreshOperationHistoryButton" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" /><Button x:Name="OpenOperationHistoryButton" Content="Open JSONL" Style="{StaticResource GhostButtonStyle}" /></WrapPanel></DockPanel>
                                    <DataGrid x:Name="OperationHistoryGrid" Grid.Row="1" />
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <TabItem Header="Operations Center">
                <Grid Margin="0,10,0,0" TextElement.Foreground="{DynamicResource TextBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel><Button x:Name="OperationsLoadButton" Content="Load workload operations" Style="{StaticResource SecondaryButtonStyle}"/><ComboBox x:Name="OperationsCommandCombo" Width="420" DisplayMemberPath="Name" SelectedValuePath="Command" ToolTip="Task types supported by the loaded Quest module for the selected workload."/></WrapPanel>
                    <TextBlock x:Name="OperationsDescriptionText" Grid.Row="1" Text="Select a workload, then load its supported operations. Use Guides for CSV formats and prerequisites." TextWrapping="Wrap" Margin="0,8"/>
                    <TabControl Grid.Row="2">
                        <TabItem Header="Task settings and preview">
                            <Grid Margin="8" TextElement.Foreground="{DynamicResource TextBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                                    <TextBlock Text="Fill required fields and any settings you want to override. Blank optional fields use Quest defaults for creation and preserve existing settings for updates." TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <StackPanel x:Name="OperationsFieldsPanel"/>
                                    <TextBlock Text="Task member IDs (optional, supported operations only)" FontWeight="SemiBold"/>
                                    <TextBox x:Name="OperationsMemberIdsBox" MinHeight="50" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Exact Quest IDs separated by commas. Use Inventory to select and copy IDs. Typed object fields above take their own IDs."/>
                                </StackPanel></ScrollViewer>
                                <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBox x:Name="OperationsResultBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="Preview details and operation reports appear here. Preview expires after 15 minutes and any input change."/>
                                    <CheckBox x:Name="OperationsScopeCheckBox" Grid.Row="1" Margin="0,8"><TextBlock Text="I reviewed the scope and defaults. Omitted selectors may apply to the whole workload." TextWrapping="Wrap"/></CheckBox>
                                    <CheckBox x:Name="OperationsExecuteCheckBox" Grid.Row="2" Content="Enable this previewed operation" Margin="0,6"/>
                                    <WrapPanel Grid.Row="3"><Button x:Name="OperationsPreviewButton" Content="Preview and validate" Style="{StaticResource SecondaryButtonStyle}"/><Button x:Name="OperationsCreateButton" Content="Create held task" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Inventory and object IDs"><Grid Margin="8" TextElement.Foreground="{DynamicResource TextBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <WrapPanel><ComboBox x:Name="OperationsInventoryKindCombo" Width="170"/><Button x:Name="OperationsInventoryButton" Content="Load inventory" Style="{StaticResource SecondaryButtonStyle}"/><Button x:Name="OperationsUseIdsButton" Content="Copy selected IDs / use as members" Style="{StaticResource GhostButtonStyle}"/><Button x:Name="OperationsExportButton" Content="Export CSV" Style="{StaticResource GhostButtonStyle}"/></WrapPanel>
                            <DataGrid x:Name="OperationsInventoryGrid" Grid.Row="1" SelectionMode="Extended"/>
                        </Grid></TabItem>
                        <TabItem Header="Templates, reports and management">
                            <Grid Margin="8" TextElement.Foreground="{DynamicResource TextBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <WrapPanel><ComboBox x:Name="ManagementKindCombo" Width="150"/><Button x:Name="ManagementLoadButton" Content="Load inventory" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel>
                                    <DataGrid x:Name="ManagementGrid" Grid.Row="1" SelectionMode="Single"/>
                                </Grid>
                                <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <ComboBox x:Name="ManagementActionCombo" DisplayMemberPath="Name" SelectedValuePath="Key"/>
                                        <TextBlock Text="Exact ID (select an inventory row or paste the ID)" Margin="0,6,0,0"/>
                                        <TextBox x:Name="ManagementIdBox"/>
                                        <TextBlock Text="New collection / template name (when needed)"/>
                                        <TextBox x:Name="ManagementNameBox"/>
                                        <TextBlock Text="Template import file (when needed)"/>
                                        <DockPanel><Button x:Name="ManagementBrowseButton" DockPanel.Dock="Right" Content="Browse" Style="{StaticResource GhostButtonStyle}"/><TextBox x:Name="ManagementFileBox"/></DockPanel>
                                    </StackPanel>
                                    <TextBox x:Name="ManagementResultBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8" Text="Preview before applying. Reports list the parent project's report links; use Quest web console to download report files."/>
                                    <StackPanel Grid.Row="2"><CheckBox x:Name="ManagementExecuteCheckBox" Content="Enable this previewed action"/><WrapPanel><Button x:Name="ManagementPreviewButton" Content="Preview" Style="{StaticResource SecondaryButtonStyle}"/><Button x:Name="ManagementApplyButton" Content="Apply" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel></StackPanel>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <TabItem Header="Active Directory">
                <Grid Margin="0,8,0,0" TextElement.Foreground="{DynamicResource TextBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel><Button x:Name="AdOpenButton" Content="Open Active Directory workspace" Style="{StaticResource SecondaryButtonStyle}"/><Button x:Name="AdPortalButton" Content="Quest setup / web console" Style="{StaticResource GhostButtonStyle}"/></WrapPanel>
                    <TextBlock x:Name="AdDescriptionText" Grid.Row="1" TextWrapping="Wrap" Margin="0,6"/>
                    <TabControl x:Name="AdTabs" Grid.Row="2">
                        <TabItem Header="Inventory and monitoring">
                            <Grid Margin="8" TextElement.Foreground="{DynamicResource TextBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
                                <WrapPanel><ComboBox x:Name="AdInventoryKindCombo" Width="230" DisplayMemberPath="Name"/><Button x:Name="AdLoadButton" Content="Load inventory" Style="{StaticResource SecondaryButtonStyle}"/><Button x:Name="AdCopyButton" Content="Copy IDs / use for matching action" Style="{StaticResource GhostButtonStyle}"/><Button x:Name="AdExportButton" Content="Export CSV" Style="{StaticResource GhostButtonStyle}"/></WrapPanel>
                                <WrapPanel Grid.Row="1" Margin="0,6"><StackPanel><TextBlock Text="Exact ID (optional)"/><TextBox x:Name="AdIdBox" Width="190"/></StackPanel><StackPanel><TextBlock Text="Parent ID (jobs / logs)"/><TextBox x:Name="AdParentIdBox" Width="160"/></StackPanel><StackPanel><TextBlock Text="Vendor filter / self-service search"/><TextBox x:Name="AdFilterBox" Width="260" ToolTip="Quest's native Filter syntax; self-service uses SearchQuery. No local PowerShell expressions are evaluated."/></StackPanel><StackPanel><TextBlock Text="Limit (1-100000)"/><TextBox x:Name="AdLimitBox" Width="110" Text="1000"/></StackPanel></WrapPanel>
                                <DataGrid x:Name="AdGrid" Grid.Row="2" SelectionMode="Extended" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding TargetId}" Width="130"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="260"/><DataGridTextColumn Header="Environment" Binding="{Binding EnvironmentId}" Width="120"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="160"/></DataGrid.Columns></DataGrid>
                                <TextBox x:Name="AdDetailsBox" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Actions and preview">
                            <Grid Margin="8" TextElement.Foreground="{DynamicResource TextBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                                    <TextBlock Text="Choose an action. Configure environments, agents and new profiles in Quest first." TextWrapping="Wrap"/>
                                    <ComboBox x:Name="AdCommandCombo" DisplayMemberPath="Name" Margin="0,6"/>
                                    <TextBlock Text="Exact target IDs (one per line or comma separated)" TextWrapping="Wrap"/>
                                    <TextBox x:Name="AdTargetIdsBox" MinHeight="55" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="Or a CSV: OrganizationId,TargetId; optional EnvironmentId and Kind" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <DockPanel><Button x:Name="AdBrowseButton" DockPanel.Dock="Right" Content="Browse" Style="{StaticResource GhostButtonStyle}"/><TextBox x:Name="AdCsvBox"/></DockPanel>
                                    <StackPanel x:Name="AdFieldsPanel" Margin="0,10,0,0"/>
                                </StackPanel></ScrollViewer>
                                <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBox x:Name="AdResultBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    <CheckBox x:Name="AdExecuteCheckBox" Grid.Row="1" Margin="0,8"><TextBlock Text="I reviewed the targets and prerequisites. This can take effect immediately; shared profiles affect other devices." TextWrapping="Wrap"/></CheckBox>
                                    <WrapPanel Grid.Row="2"><Button x:Name="AdPreviewButton" Content="Preview and validate" Style="{StaticResource SecondaryButtonStyle}"/><Button x:Name="AdApplyButton" Content="Apply AD action" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="Guides">
                <Grid Margin="0,10,0,0" TextElement.Foreground="{DynamicResource TextBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel><ComboBox x:Name="GuideTopicCombo" Width="340" DisplayMemberPath="Title"/><Button x:Name="GuideSamplesButton" Content="Sample CSV folder" Style="{StaticResource SecondaryButtonStyle}"/><Button x:Name="GuidePortalButton" Content="Quest web console" Style="{StaticResource GhostButtonStyle}"/><Button x:Name="GuideDocsButton" Content="Quest documentation" Style="{StaticResource GhostButtonStyle}"/></WrapPanel>
                    <TextBox x:Name="GuideTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,6">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatusText" Text="Ready." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                <CheckBox x:Name="DarkModeCheckBox" Grid.Column="1" Content="Dark mode" Margin="0,0,16,0" ToolTip="Switch between the light and dark application themes. The selection is saved for the next session." />
                <ProgressBar x:Name="BusyProgressBar" Grid.Column="2" Height="7" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
