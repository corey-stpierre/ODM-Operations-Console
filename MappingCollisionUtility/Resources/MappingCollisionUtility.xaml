<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        x:Name="MappingCollisionWindow"
        Title="Quest ODM Mapping Collision Utility 1.1.0 Preview 6"
        Width="1450" Height="920" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- Theme brushes remain unfrozen so the controller can update their Color values safely at runtime. -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3D5B96"  po:Freeze="False" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#2E4778"  po:Freeze="False" />
        <SolidColorBrush x:Key="MetricValueBrush" Color="#2E4778"  po:Freeze="False" />
        <SolidColorBrush x:Key="AccentBrush" Color="#62C0DA"  po:Freeze="False" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#E8F7FB"  po:Freeze="False" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#17384A"  po:Freeze="False" />
        <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF"  po:Freeze="False" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"  po:Freeze="False" />
        <SolidColorBrush x:Key="InputSurfaceBrush" Color="#FFFFFF"  po:Freeze="False" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F6FBFE"  po:Freeze="False" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D0D8E5"  po:Freeze="False" />
        <SolidColorBrush x:Key="TextBrush" Color="#273142"  po:Freeze="False" />
        <SolidColorBrush x:Key="HeadingBrush" Color="#253148"  po:Freeze="False" />
        <SolidColorBrush x:Key="MutedBrush" Color="#657086"  po:Freeze="False" />
        <SolidColorBrush x:Key="GridLineBrush" Color="#E8EDF4"  po:Freeze="False" />
        <SolidColorBrush x:Key="GridAlternateBrush" Color="#F8FBFD"  po:Freeze="False" />
        <SolidColorBrush x:Key="GridHeaderBrush" Color="#EDF2F8"  po:Freeze="False" />
        <SolidColorBrush x:Key="GridHeaderTextBrush" Color="#39465A"  po:Freeze="False" />
        <SolidColorBrush x:Key="SelectionBrush" Color="#DCE9F8"  po:Freeze="False" />
        <SolidColorBrush x:Key="SelectionTextBrush" Color="#17233A"  po:Freeze="False" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B54343"  po:Freeze="False" />
        <SolidColorBrush x:Key="WarningBrush" Color="#A86B18"  po:Freeze="False" />
        <SolidColorBrush x:Key="WarningLightBrush" Color="#FFF5DF"  po:Freeze="False" />
        <SolidColorBrush x:Key="WarningBorderBrush" Color="#E3B76A"  po:Freeze="False" />
        <SolidColorBrush x:Key="WarningTextBrush" Color="#8A5510"  po:Freeze="False" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D5B"  po:Freeze="False" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect Color="#22000000" BlurRadius="6" ShadowDepth="1" Opacity="0.16" /></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MetricValueBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Padding" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="7,5" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource AccentLightBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,14,3" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource MetricValueBrush}" /><Setter Property="Foreground" Value="{DynamicResource MetricValueBrush}" />
        </Style>
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="14,7" /><Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" CornerRadius="14" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PrimaryBrush}" /><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentLightBrush}" /></Trigger>
                            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsSelected" Value="True" /></MultiTrigger.Conditions><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PrimaryDarkBrush}" /></MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}" /><Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLineBrush}" /><Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="True" /><Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" /><Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Extended" /><Setter Property="SelectionUnit" Value="FullRow" /><Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAlternateBrush}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" /><Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBrush}" /><Setter Property="Foreground" Value="{DynamicResource GridHeaderTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="8,7" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" /></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}" />
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" /></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="Separator"><Setter Property="Background" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /></Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="7,5" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Width="126" Height="54" VerticalAlignment="Center"><Image x:Name="QuestLogoImage" Width="122" Height="31" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" /></Grid>
                <StackPanel Grid.Column="1" Margin="14,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="Mapping Collision Utility" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
                    <TextBlock Text="Read-only identity-anchor analysis for AD and Entra migration mappings" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource WarningLightBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="11,6" VerticalAlignment="Center">
                    <TextBlock Text="PREVIEW — No directory writes" Foreground="{DynamicResource WarningTextBrush}" FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,12,18,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="1. Export the collectors" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Save one self-contained script for the source environment and one for the target. Each script prompts for Active Directory or Entra ID and creates a normalized user-object CSV plus a SHA-256 manifest. Groups, contacts, applications, devices, and deleted objects are outside this preview." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,10" />
                    <WrapPanel>
                        <Button x:Name="ExportBothCollectorsButton" Content="Export both…" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,6" />
                        <Button x:Name="SaveSourceCollectorButton" Content="Save source script" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" />
                        <Button x:Name="SaveTargetCollectorButton" Content="Save target script" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" />
                        <Button x:Name="OpenCollectorFolderButton" Content="Open packaged scripts" Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,6" />
                    </WrapPanel>
                    <TextBlock x:Name="CollectorStatusText" Text="Collector package ready." Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="2. Load source and target inventories" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Source CSV" VerticalAlignment="Center" />
                        <TextBox x:Name="SourceCsvPathBox" Grid.Column="1" Margin="0,0,6,0" />
                        <Button x:Name="BrowseSourceCsvButton" Grid.Column="2" Content="Browse" Style="{StaticResource GhostButtonStyle}" Margin="0" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Target CSV" VerticalAlignment="Center" />
                        <TextBox x:Name="TargetCsvPathBox" Grid.Column="1" Margin="0,0,6,0" />
                        <Button x:Name="BrowseTargetCsvButton" Grid.Column="2" Content="Browse" Style="{StaticResource GhostButtonStyle}" Margin="0" />
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Report folder" VerticalAlignment="Center" />
                        <TextBox x:Name="OutputDirectoryBox" Grid.Column="1" Margin="0,0,6,0" />
                        <Button x:Name="BrowseOutputDirectoryButton" Grid.Column="2" Content="Browse" Style="{StaticResource GhostButtonStyle}" Margin="0" />
                    </Grid>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <CheckBox x:Name="CheckInternalDuplicatesCheckBox" Content="Internal duplicates" IsChecked="True" />
                            <CheckBox x:Name="CheckCrossAttributeCheckBox" Content="Cross-attribute matches" IsChecked="True" />
                            <CheckBox x:Name="IncludeEmployeeIdCheckBox" Content="Employee ID" IsChecked="True" />
                            <CheckBox x:Name="IncludeWeakAliasCheckBox" Content="mailNickname aliases" IsChecked="True" />
                        </WrapPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button x:Name="LoadSampleDataButton" Content="Load sample" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button x:Name="AnalyzeButton" Content="Analyze inventories" Style="{StaticResource AccentButtonStyle}" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="18,0,18,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Text="Source objects" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="SourceCountText" Text="—" Style="{StaticResource MetricValueStyle}" /></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Text="Target objects" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="TargetCountText" Text="—" Style="{StaticResource MetricValueStyle}" /></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Text="Critical" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="CriticalCountText" Text="—" Style="{StaticResource MetricValueStyle}" Foreground="{DynamicResource DangerBrush}" /></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Text="High" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="HighCountText" Text="—" Style="{StaticResource MetricValueStyle}" Foreground="{DynamicResource WarningBrush}" /></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Text="Ambiguous rows" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="AmbiguousCountText" Text="—" Style="{StaticResource MetricValueStyle}" /></StackPanel></Border>
            <Border Grid.Column="5" Style="{StaticResource MetricCardStyle}" Margin="0"><StackPanel><TextBlock Text="Recommended" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="RecommendedCountText" Text="—" Style="{StaticResource MetricValueStyle}" Foreground="{DynamicResource SuccessBrush}" /></StackPanel></Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="18,0,18,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0"><Label Content="Severity / status" /><ComboBox x:Name="StatusFilterCombo" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0"><Label Content="Category / disposition" /><ComboBox x:Name="CategoryFilterCombo" /></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0"><Label Content="Text contains" /><TextBox x:Name="SearchFilterBox" /></StackPanel>
                <WrapPanel Grid.Column="3" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <Button x:Name="ApplyFilterButton" Content="Apply filter" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button x:Name="ClearFilterButton" Content="Clear" Style="{StaticResource GhostButtonStyle}" />
                    <Button x:Name="OpenHtmlReportButton" Content="Open HTML report" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" />
                    <Button x:Name="OpenOutputFolderButton" Content="Open output folder" Style="{StaticResource GhostButtonStyle}" IsEnabled="False" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="18,0,18,10" Padding="10">
            <TabControl x:Name="ResultsTabControl">
                <TabItem Header="Collisions"><DataGrid x:Name="CollisionsGrid" Margin="0,9,0,0" /></TabItem>
                <TabItem Header="Mapping candidates"><DataGrid x:Name="MappingCandidatesGrid" Margin="0,9,0,0" /></TabItem>
                <TabItem Header="Ambiguous"><DataGrid x:Name="AmbiguousMappingsGrid" Margin="0,9,0,0" /></TabItem>
                <TabItem Header="Inventory quality"><DataGrid x:Name="InventoryQualityGrid" Margin="0,9,0,0" /></TabItem>
                <TabItem Header="Unmatched source"><DataGrid x:Name="UnmatchedSourceGrid" Margin="0,9,0,0" /></TabItem>
                <TabItem Header="Run log">
                    <Grid Margin="0,9,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBox x:Name="RunLogBox" Grid.Row="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        <DockPanel Grid.Row="1" Margin="0,9,0,0">
                            <TextBlock x:Name="UtilityLogRetentionStatusText" Text="Log maintenance has not run." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <TextBlock Text="Keep" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="UtilityLogRetentionDaysCombo" Width="78" SelectedIndex="2" Margin="0,0,6,0" ToolTip="Number of days to retain Mapping Collision Utility session logs.">
                                    <ComboBoxItem Content="7" />
                                    <ComboBoxItem Content="14" />
                                    <ComboBoxItem Content="30" />
                                    <ComboBoxItem Content="60" />
                                    <ComboBoxItem Content="90" />
                                    <ComboBoxItem Content="180" />
                                </ComboBox>
                                <TextBlock Text="days" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button x:Name="OpenUtilityLogsButton" Content="Open logs" Style="{StaticResource GhostButtonStyle}" />
                                <Button x:Name="CleanUtilityLogsButton" Content="Apply retention" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button x:Name="ClearUtilityStoredLogsButton" Content="Clear stored logs" Style="{StaticResource GhostButtonStyle}" ToolTip="Deletes prior utility session logs while preserving the active session log." />
                                <Button x:Name="ClearRunLogViewButton" Content="Clear view" Style="{StaticResource GhostButtonStyle}" ToolTip="Clears only the visible run-log pane." />
                            </WrapPanel>
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatusText" Text="Ready." VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                <CheckBox x:Name="DarkModeCheckBox" Grid.Column="1" Content="Dark mode" Margin="0,0,14,0" ToolTip="Switch between the light and dark utility themes. The selection is saved for the next session." />
                <ProgressBar x:Name="BusyProgressBar" Grid.Column="2" Height="8" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
